# Copier en .env sur le serveur (jamais versionné, jamais dans l'image docker).
# docker-compose le charge via `env_file: .env`.

# Signature des cookies de session et des nonces d'arrosage.
# Doit être stable : le régénérer déconnecte tout le monde (c'est le bouton panique).
#   openssl rand -hex 32
SECRET_KEY=

# SHA-256 du mot de passe d'arrosage. C'est la clé HMAC du challenge-réponse,
# donc un équivalent-mot-de-passe : utiliser un mot de passe à forte entropie,
# un SHA-256 non salé d'un mot de passe mémorisable se casse en secondes.
#   openssl rand -base64 18                       # le mot de passe à retenir
#   printf %s 'LE_MOT_DE_PASSE' | shasum -a 256   # la valeur à mettre ici
WATERING_PASSWORD_SHA256=

# Agent d'arrosage sur le raspberry, joignable par le VPN.
AGENT_URL=http://10.15.8.27:8787
# Même valeur que AGENT_HMAC_KEY dans /etc/well-agent.env sur le raspberry.
#   openssl rand -hex 32
AGENT_HMAC_KEY=

# 1 en production (HTTPS), 0 pour un `python server.py` local en http.
COOKIE_SECURE=1

# Base de l'historique d'arrosage. Volontairement séparée de well.db, qui est
# monté fichier-par-fichier : son journal SQLite atterrirait dans le conteneur.
WATERING_DB=/app/data/watering.db
