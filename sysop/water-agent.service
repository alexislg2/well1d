[Unit]
Description=LinkTap watering agent (well1d)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/well1d
EnvironmentFile=/etc/well-agent.env

ExecStart=/usr/bin/python3 -u /home/pi/well1d/water_agent.py

# always (et non on-failure) + pas de limite de démarrages : le VPN peut flapper
Restart=always
RestartSec=5
StartLimitIntervalSec=0

StandardOutput=append:/var/log/ramlog/water_agent.log
StandardError=append:/var/log/ramlog/water_agent_error.log

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/ramlog

[Install]
WantedBy=multi-user.target
