[Unit]
Description=Well Water Height Logger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/well1d

# Clé partagée avec le serveur : well.py signe désormais ses dépôts de mesures.
EnvironmentFile=/etc/well-agent.env

# On attend un peu que tout soit bien en place
ExecStartPre=/bin/sleep 60

ExecStart=/usr/bin/python3 -u /home/pi/well1d/well.py

Restart=on-failure
RestartSec=10

# Journal systemd (en RAM, Storage=volatile) plutôt qu'un fichier sur la carte SD :
# on évite d'user la carte et de l'abîmer lors des coupures de courant.
# Lire avec : journalctl -u well
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
